# Zeilenenden vereinheitlichen - unterdrueckt die CRLF-Warnungen beim Commit
* text=auto eol=lf

# Batch-Dateien brauchen unter Windows CRLF, sonst laufen sie unzuverlaessig
*.bat text eol=crlf
*.cmd text eol=crlf

# Kalenderdateien NICHT anfassen.
# RFC 5545 schreibt CRLF vor. Wuerde Git hier auf LF normalisieren,
# lehnen strenge Parser wie Google Kalender den Feed ab.
*.ics -text

# Binaerdateien nicht anfassen
*.png binary
*.jpg binary
*.ico binary
*.zip binary
